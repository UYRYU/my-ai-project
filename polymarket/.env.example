# Polymarket Tracker - 環境変数テンプレート
# このファイルを .env にコピーして値を埋めてください
# cp .env.example .env

# ===== Polymarket API 認証 (ライブトレード時に必要) =====
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# ===== トレードモード =====
# true = ドライラン (ログのみ、実際には賭けない)
# false = ライブ (実際に注文を出す)
DRY_RUN=true
