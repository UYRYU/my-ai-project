//| Strategy: atr_break_50bd79db
//+------------------------------------------------------------------+
#property copyright "FX Research Factory"
#property version   "1.00"
#property strict

input double LotSize = 0.1;
input int    MagicNumber = 79426;
input int    Slippage = 3;

int OnInit() { return(INIT_SUCCEEDED); }
void OnDeinit(const int reason) {}

void OnTick()
{
   // Skip if already in position
   for(int i=OrdersTotal()-1; i>=0; i--)
      if(OrderSelect(i, SELECT_BY_POS) && OrderMagicNumber() == MagicNumber)
      {
         ManagePosition();
         return;
      }

   if(Hour() < 13 || Hour() >= 22) return; // NewYork only

   // LowVol Filter: ATR must be below median of last 60 bars
   double atr_now = iATR(NULL, 0, 10, 0);
   double atr_arr[];
   ArrayResize(atr_arr, 60);
   for(int k=0; k<60; k++) atr_arr[k] = iATR(NULL, 0, 10, k);
   ArraySort(atr_arr);
   double atr_median = atr_arr[60//2];
   if(atr_now > atr_median) return; // Too volatile

   int signal = 0;

   double atr_val = iATR(NULL, 0, 5, 1);
   double move = MathAbs(Close[1] - Close[2]);
   if(move > atr_val * 1.0 && Close[1] > Close[2]) signal = 1;  // Buy
   if(move > atr_val * 1.0 && Close[1] < Close[2]) signal = -1; // Sell

   if(signal == 0) return;

   double atr = iATR(NULL, 0, 10, 1);
   double tp_dist = atr * 6.0;
   double sl_dist = atr * 1.5;

   if(signal == 1) {
      double price = Ask;
      double sl = price - sl_dist;
      double tp = price + tp_dist;
      OrderSend(NULL, OP_BUY, LotSize, price, Slippage, sl, tp, "FXFactory_atr_break_02", MagicNumber, 0, clrGreen);
   }
   if(signal == -1) {
      double price = Bid;
      double sl = price + sl_dist;
      double tp = price - tp_dist;
      OrderSend(NULL, OP_SELL, LotSize, price, Slippage, sl, tp, "FXFactory_atr_break_02", MagicNumber, 0, clrRed);
   }
}

void ManagePosition()
{
   if(!OrderSelect(0, SELECT_BY_POS)) return;

   // Breakeven
   if(OrderType() == OP_BUY && Bid - OrderOpenPrice() >= 3.0 * Point * 10)
      if(OrderStopLoss() < OrderOpenPrice())
         OrderModify(OrderTicket(), OrderOpenPrice(), OrderOpenPrice() + Point, OrderTakeProfit(), 0);
   if(OrderType() == OP_SELL && OrderOpenPrice() - Ask >= 3.0 * Point * 10)
      if(OrderStopLoss() > OrderOpenPrice())
         OrderModify(OrderTicket(), OrderOpenPrice(), OrderOpenPrice() - Point, OrderTakeProfit(), 0);

   // Trailing Stop (ATR-based)
   double trail_dist = iATR(NULL, 0, 10, 0) * 0.7;
   if(OrderType() == OP_BUY) {
      double new_sl = Bid - trail_dist;
      if(new_sl > OrderStopLoss()) OrderModify(OrderTicket(), OrderOpenPrice(), new_sl, OrderTakeProfit(), 0);
   }
   if(OrderType() == OP_SELL) {
      double new_sl = Ask + trail_dist;
      if(new_sl < OrderStopLoss() || OrderStopLoss() == 0) OrderModify(OrderTicket(), OrderOpenPrice(), new_sl, OrderTakeProfit(), 0);
   }

   // Max bars exit
   if(TimeCurrent() - OrderOpenTime() >= 120 * 60) {
      if(OrderType() == OP_BUY) OrderClose(OrderTicket(), OrderLots(), Bid, 3);
      if(OrderType() == OP_SELL) OrderClose(OrderTicket(), OrderLots(), Ask, 3);
   }
}
//+------------------------------------------------------------------+
