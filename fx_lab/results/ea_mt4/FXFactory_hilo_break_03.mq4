//| FXFactory_hilo_break_03.mq4
//| Auto-generated by FX Research Factory Phase 3
//| Strategy: hilo_break_00369025
//+------------------------------------------------------------------+
#property copyright "FX Research Factory"
#property version   "1.00"
#property strict

input double LotSize = 0.1;
input int    MagicNumber = 30577;
input int    Slippage = 3;

int OnInit() { return(INIT_SUCCEEDED); }
void OnDeinit(const int reason) {}

void OnTick()
{
   // Skip if already in position
   for(int i=OrdersTotal()-1; i>=0; i--)
      if(OrderSelect(i, SELECT_BY_POS) && OrderMagicNumber() == MagicNumber)
      {
         ManagePosition();
         return;
      }

   if(Hour() < 13 || Hour() >= 22) return; // NewYork only

   // LowVol Filter: ATR must be below median of last 120 bars
   double atr_now = iATR(NULL, 0, 14, 0);
   double atr_arr[];
   ArrayResize(atr_arr, 120);
   for(int k=0; k<120; k++) atr_arr[k] = iATR(NULL, 0, 14, k);
   ArraySort(atr_arr);
   double atr_median = atr_arr[120//2];
   if(atr_now > atr_median) return; // Too volatile

   int signal = 0;

   double highest = High[iHighest(NULL, 0, MODE_HIGH, 15, 2)];
   double lowest  = Low[iLowest(NULL, 0, MODE_LOW, 15, 2)];
   if(Close[1] > highest) signal = 1;   // Buy breakout
   if(Close[1] < lowest)  signal = -1;  // Sell breakout

   if(signal == 0) return;

   double atr = iATR(NULL, 0, 14, 1);
   double tp_dist = atr * 5.0;
   double sl_dist = atr * 1.5;

   if(signal == 1) {
      double price = Ask;
      double sl = price - sl_dist;
      double tp = price + tp_dist;
      OrderSend(NULL, OP_BUY, LotSize, price, Slippage, sl, tp, "FXFactory_hilo_break_03", MagicNumber, 0, clrGreen);
   }
   if(signal == -1) {
      double price = Bid;
      double sl = price + sl_dist;
      double tp = price - tp_dist;
      OrderSend(NULL, OP_SELL, LotSize, price, Slippage, sl, tp, "FXFactory_hilo_break_03", MagicNumber, 0, clrRed);
   }
}

void ManagePosition()
{
   if(!OrderSelect(0, SELECT_BY_POS)) return;



   // Max bars exit
   if(TimeCurrent() - OrderOpenTime() >= 120 * 60) {
      if(OrderType() == OP_BUY) OrderClose(OrderTicket(), OrderLots(), Bid, 3);
      if(OrderType() == OP_SELL) OrderClose(OrderTicket(), OrderLots(), Ask, 3);
   }
}
//+------------------------------------------------------------------+
