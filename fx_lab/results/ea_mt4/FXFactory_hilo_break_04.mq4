//| Auto-generated by FX Research Factory Phase 3
//| Strategy: hilo_break_80ddd660
//+------------------------------------------------------------------+
#property copyright "FX Research Factory"
#property version   "1.00"
#property strict

input double LotSize = 0.1;
input int    MagicNumber = 34469;
input int    Slippage = 3;

int OnInit() { return(INIT_SUCCEEDED); }
void OnDeinit(const int reason) {}

void OnTick()
{
   // Skip if already in position
   for(int i=OrdersTotal()-1; i>=0; i--)
      if(OrderSelect(i, SELECT_BY_POS) && OrderMagicNumber() == MagicNumber)
      {
         ManagePosition();
         return;
      }

   if(Hour() < 7 || Hour() >= 16) return; // London only


   int signal = 0;

   double highest = High[iHighest(NULL, 0, MODE_HIGH, 5, 2)];
   double lowest  = Low[iLowest(NULL, 0, MODE_LOW, 5, 2)];
   if(Close[1] > highest) signal = 1;   // Buy breakout
   if(Close[1] < lowest)  signal = -1;  // Sell breakout

   if(signal == 0) return;

   double atr = iATR(NULL, 0, 14, 1);
   double tp_dist = atr * 3.0;
   double sl_dist = atr * 1.0;

   if(signal == 1) {
      double price = Ask;
      double sl = price - sl_dist;
      double tp = price + tp_dist;
      OrderSend(NULL, OP_BUY, LotSize, price, Slippage, sl, tp, "FXFactory_hilo_break_04", MagicNumber, 0, clrGreen);
   }
   if(signal == -1) {
      double price = Bid;
      double sl = price + sl_dist;
      double tp = price - tp_dist;
      OrderSend(NULL, OP_SELL, LotSize, price, Slippage, sl, tp, "FXFactory_hilo_break_04", MagicNumber, 0, clrRed);
   }
}

void ManagePosition()
{
   if(!OrderSelect(0, SELECT_BY_POS)) return;

   // Breakeven
   if(OrderType() == OP_BUY && Bid - OrderOpenPrice() >= 5.0 * Point * 10)
      if(OrderStopLoss() < OrderOpenPrice())
         OrderModify(OrderTicket(), OrderOpenPrice(), OrderOpenPrice() + Point, OrderTakeProfit(), 0);
   if(OrderType() == OP_SELL && OrderOpenPrice() - Ask >= 5.0 * Point * 10)
      if(OrderStopLoss() > OrderOpenPrice())
         OrderModify(OrderTicket(), OrderOpenPrice(), OrderOpenPrice() - Point, OrderTakeProfit(), 0);

   // Trailing Stop (ATR-based)
   double trail_dist = iATR(NULL, 0, 14, 0) * 1.0;
   if(OrderType() == OP_BUY) {
      double new_sl = Bid - trail_dist;
      if(new_sl > OrderStopLoss()) OrderModify(OrderTicket(), OrderOpenPrice(), new_sl, OrderTakeProfit(), 0);
   }
   if(OrderType() == OP_SELL) {
      double new_sl = Ask + trail_dist;
      if(new_sl < OrderStopLoss() || OrderStopLoss() == 0) OrderModify(OrderTicket(), OrderOpenPrice(), new_sl, OrderTakeProfit(), 0);
   }

   // Max bars exit
   if(TimeCurrent() - OrderOpenTime() >= 60 * 60) {
      if(OrderType() == OP_BUY) OrderClose(OrderTicket(), OrderLots(), Bid, 3);
      if(OrderType() == OP_SELL) OrderClose(OrderTicket(), OrderLots(), Ask, 3);
   }
}
//+------------------------------------------------------------------+
