# Polymarket API
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Bot Settings
POLL_INTERVAL_SEC=10
WS_RECONNECT_DELAY_SEC=5
WS_MAX_RECONNECT_ATTEMPTS=10

# Signal Thresholds
MISPRICING_THRESHOLD=0.02
SPREAD_MAX=0.10
LIQUIDITY_MIN_SIZE=50.0
MOMENTUM_WINDOW_SEC=60
MOMENTUM_MAX_CHANGE=0.05
CONFIDENCE_THRESHOLD=60.0

# Signal Weights (must sum to 1.0)
WEIGHT_MISPRICING=0.40
WEIGHT_SPREAD=0.25
WEIGHT_LIQUIDITY=0.20
WEIGHT_MOMENTUM=0.15

# Paper Trading
PAPER_TRADE_SIZE=10.0
PAPER_TAKE_PROFIT=0.05
PAPER_STOP_LOSS=0.03
PAPER_TIMEOUT_SEC=300
PAPER_MAX_POSITIONS=5

# Notifications
DISCORD_WEBHOOK_URL=
ENABLE_DISCORD=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
