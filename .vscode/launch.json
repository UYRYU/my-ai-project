{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tracker 起動 (Mock)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "DATA_SOURCE": "mock",
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "Tracker 起動 (Live)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "DATA_SOURCE": "polymarket",
                "PYTHONIOENCODING": "utf-8"
            }
        },
        {
            "name": "pytest 実行",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
