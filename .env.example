ANTHROPIC_API_KEY=
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_FUNDER_ADDRESS=0x...
POLYMARKET_HOST=https://clob.polymarket.com

BOT_SPORTS_TAGS=nba,nfl,cbb,cfb
BOT_MIN_EDGE=0.01
BOT_MAX_POSITION_USD=25
BOT_POLL_SECONDS=5
BOT_DRY_RUN=true

