# ============================================================
# AI News Automation - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Anthropic Claude API ---
# Required for AI summarization, structuring, and content generation.
# Without this, the system falls back to template-based dummy output.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- X (Twitter) API ---
# Required only when implementing auto-post to X (future feature)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- note.com API ---
# Required only when implementing auto-post to note (future feature)
NOTE_API_KEY=

# --- Application Settings Override ---
# These override config/settings.yaml values if set
# LOG_LEVEL=INFO
# SIMILARITY_THRESHOLD=0.8
# X_POSTS_PER_SOURCE=3
