# =============================================
# Polymarket Wallet Tracker 設定
# =============================================

# Discord Webhook URL (通知を有効にする場合に設定)
DISCORD_WEBHOOK_URL=

# データ取得間隔（秒）
POLL_INTERVAL_SEC=60

# シグナル検知: 時間窓（秒）
SIGNAL_TIME_WINDOW_SEC=300

# シグナル検知: 最小ウォレット数
SIGNAL_MIN_WALLETS=3

# シグナル検知: 強シグナル金額閾値（USDC）
SIGNAL_STRONG_AMOUNT_THRESHOLD=1000

# データソース: "mock" or "polymarket"
DATA_SOURCE=mock

# SQLiteデータベースパス
DB_PATH=tracker.db

# ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================
# Execution（自動売買）設定
# =============================================

# 取引モード: "paper"（仮想）, "live"（実注文）, "dry-run"（表示のみ）
TRADING_MODE=paper

# 1回あたりの最大注文額（USDC）
MAX_ORDER_USD=50

# マーケットごとの最大ポジションサイズ（USDC）
MAX_POSITION_USD=200

# 日次損失上限（USDC）- 到達で自動停止
MAX_DAILY_LOSS_USD=100

# 発注対象シグナルレベル: "STRONG" or "NORMAL"
MIN_SIGNAL_LEVEL=STRONG

# 同一マーケットへの連続発注制限（秒）
ORDER_COOLDOWN_SEC=300

# Live取引の有効化フラグ（二重安全装置）
# TRADING_MODE=live でも、これが false なら実注文は送信されない
ALLOW_LIVE_TRADING=false

# 緊急停止フラグ: true で全注文を即座に停止
# ファイル "KILL_SWITCH" をプロジェクトルートに作成しても停止する
KILL_SWITCH=false

# =============================================
# Polymarket 認証情報（Live取引時のみ必要）
# =============================================
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
