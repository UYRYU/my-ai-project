# Polymarket Wallet Tracker 設定

# Discord Webhook URL (通知を有効にする場合に設定)
DISCORD_WEBHOOK_URL=

# データ取得間隔（秒）
POLL_INTERVAL_SEC=60

# シグナル検知: 時間窓（秒）
SIGNAL_TIME_WINDOW_SEC=300

# シグナル検知: 最小ウォレット数
SIGNAL_MIN_WALLETS=3

# シグナル検知: 強シグナル金額閾値（USDC）
SIGNAL_STRONG_AMOUNT_THRESHOLD=1000

# データソース: "mock" or "polymarket"
DATA_SOURCE=mock

# SQLiteデータベースパス
DB_PATH=tracker.db

# ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
