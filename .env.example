ANTHROPIC_API_KEY=
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_FUNDER_ADDRESS=0x...
POLYMARKET_HOST=https://clob.polymarket.com

# Optional: L2 API creds — if unset, auto-derived from private key on boot
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Realistic defaults for cautious live operation
BOT_SPORTS_TAGS=nba,nfl,cbb,cfb
BOT_MIN_EDGE=0.003          # 0.3% — anything smaller gets eaten by fees/slippage
BOT_MAX_POSITION_USD=50     # per-basket cap; start small
BOT_BANKROLL_USD=500        # total capital for Kelly sizing
BOT_POLL_SECONDS=2          # REST polling; move to WS for serious use
BOT_DRY_RUN=true

# Offline / CI modes
BOT_MOCK=false
BOT_ONCE=false
