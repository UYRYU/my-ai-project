# Polymarket Arb Bot — Environment Variables
# Copy to .env and fill in your values

# === Scan Settings ===
SCAN_INTERVAL=60          # seconds between scans
MIN_PROFIT=0.015          # 1.5% minimum profit to alert
MIN_VOLUME=50000          # $50K minimum market volume
MAX_EVENTS=500            # max events per scan

# === Alerts ===
WEBHOOK_URL=              # Discord: https://discord.com/api/webhooks/...
                          # Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage

# === Execution ===
EXECUTION_MODE=dry_run    # "dry_run" or "live"
POSITION_SIZE=50          # USD per trade
MAX_POSITION=200          # max USD per single trade

# === Polymarket API (for live trading) ===
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# === Logging ===
LOG_DIR=bot_logs
DEBUG=                    # set to "1" for debug logging
